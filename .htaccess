# Only public/ is meant for the web. When the host cannot point the document
# root at public/ (free and shared hosting), this file sends visitors there
# and refuses every other path in the project folder: an allow-list, so a
# folder or file uploaded by mistake stays private too. includes/ and
# storage/ also carry their own Deny rules.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Built from the request URI, so it works in any install folder.
    RewriteCond %{REQUEST_URI} ^(.*/)$
    RewriteRule ^$ %1public/ [R=302,L]
    RewriteRule !^public(/|$) - [F,L]
</IfModule>
