# Local configuration with real credentials
includes/config.local.php

# Uploaded files — never commit student documents.
# The directories are kept (via .gitkeep); their contents are not.
storage/uploads/**
!storage/uploads/
!storage/uploads/requirements/
!storage/uploads/**/.gitkeep

# Tooling caches
.impeccable/

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# Database backups - contain every password hash, never commit them
storage/backups/**
!storage/backups/
!storage/backups/.gitkeep
!storage/backups/.htaccess

# Mail log written by the 'log' mail transport
storage/logs/
